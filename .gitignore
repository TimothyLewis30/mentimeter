# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# KREDENSIAL & DATA RUNTIME — JANGAN PERNAH DI-COMMIT
# ---------------------------------------------------------------------------
# Password admin, session secret, token operator, snapshot room, arsip, dan
# state lama semuanya berada di file JSON. Semua file tersebut di-ignore.
credentials.json
*.credentials.json
data/**/*.json
data/**/*.jsonl
data/**/*.ndjson

# ---------------------------------------------------------------------------
# Environment & secrets lain
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Log, cache, dan artefak lokal
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.superpowers/
.DS_Store
Thumbs.db
*.tmp
